{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": true,
    "types": [ "node", "vitest/globals" ],
    "verbatimModuleSyntax": false,
    "erasableSyntaxOnly": false,
    "sourceMap": true,
    "paths": {
      "@renderer/*": [ "./src/renderer/src/*" ],
      "@common/*": [ "./src/common/*" ],
      "@main/*": [ "./src/main/*" ],
      "@db/*": [ "./src/main/db/*" ]
    }
  },
  "include": [ "test/**/*", "src/types/*" ]
}
